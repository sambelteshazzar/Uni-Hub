# Server
NODE_ENV=development
PORT=5000
# Comma-separated list of frontend origins allowed by CORS.
# Production: FRONTEND_URL=https://jertscart.com
FRONTEND_URL=http://localhost:8000,http://127.0.0.1:8000
# Public origin used in magic-link emails (student verification, etc.).
# Falls back to the first entry of FRONTEND_URL, then to localhost:8000.
# Set this explicitly in production to your real frontend origin.
APP_PUBLIC_URL=http://localhost:8000
# Production: APP_PUBLIC_URL=https://jertscart.com

# Database (SQLite — local dev fallback)
SQLITE_PATH=./data/jertscart.db

# Turso (libSQL — shared cloud DB for production)
# TURSO_URL=libsql://your-database.your-region.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Auth
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE=7d
# Admin account is auto-created/synced from these on every server start.
# Production: ADMIN_EMAIL=admin@jertscart.com with a strong 12+ char password.
ADMIN_EMAIL=admin@unihub.local
ADMIN_PASSWORD=change-me-on-first-run

# CSRF — random 32+ char hex string. MUST be set in production, otherwise
# every server restart invalidates all CSRF tokens and users see 403s on
# every POST/PUT/DELETE until they hard-refresh.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (Nodemailer) — transactional mail (student verification, password
# reset, order updates). Production: use your jertscart.com mailbox,
# e.g. smtp.zoho.com with noreply@jertscart.com.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@jertscart.com

# Newsletter (Brevo transactional API)
# Get the key at https://app.brevo.com — the sender domain must be verified
# in Brevo (SPF/DKIM DNS records on jertscart.com) or mail goes to spam.
BREVO_API_KEY=
NEWSLETTER_FROM_EMAIL=noreply@jertscart.com

# Paystack (payment gateway)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
