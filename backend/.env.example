# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/uni-hub
# For production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/uni-hub?retryWrites=true&w=majority

# JWT Secret - GENERATE A STRONG RANDOM STRING FOR PRODUCTION!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# Admin Credentials - CHANGE THESE BEFORE DEPLOYMENT!
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_PASSWORD=CHANGE_ME_To_A_Strong_Password_123!

# Cloudinary (For image uploads - sign up at cloudinary.com)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (Nodemailer configuration)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8000

# Sentry (Error & performance monitoring - sign up at sentry.io)
# Leave blank to disable Sentry
SENTRY_DSN=

# MongoDB Atlas (if using Atlas, monitoring is built-in)
# Atlas provides: query metrics, real-time performance, slow query tracking
# Access via: Atlas Dashboard > Metrics / Performance Insight
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/uni-hub?retryWrites=true&w=majority

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
