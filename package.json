{
  "name": "uni-hub",
  "version": "1.0.0",
  "description": "Student marketplace for buying and selling items within university communities",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint js/**/*.js --fix",
    "lint:check": "eslint js/**/*.js",
    "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\"",
    "format:check": "prettier --check \"js/**/*.js\" \"css/**/*.css\"",
    "start": "http-server -p 8000",
    "test": "echo 'Tests not configured yet'"
  },
  "keywords": [
    "marketplace",
    "students",
    "uni-hub",
    "e-commerce"
  ],
  "author": "Uni-Hub Team",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.56.0",
    "http-server": "^14.1.1",
    "prettier": "^3.1.1",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@sentry/browser": "^10.50.0",
    "socket.io-client": "^4.8.3"
  }
}
