{
  "name": "uni-hub",
  "version": "1.0.0",
  "description": "JERTS CART — student marketplace for buying and selling items within university communities",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint js/**/*.js --fix",
    "lint:check": "eslint js/**/*.js",
    "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\"",
    "format:check": "prettier --check \"js/**/*.js\" \"css/**/*.css\"",
    "start": "http-server . -p 8000 -c-1 --cors",
    "test": "echo 'Tests not configured yet'",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed"
  },
  "keywords": [
    "marketplace",
    "students",
    "jerts-cart",
    "uni-hub",
    "e-commerce"
  ],
  "author": "JERTS CART Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "eslint": "^8.56.0",
    "http-server": "^14.1.1",
    "prettier": "^3.1.1",
    "vercel": "^54.9.1",
    "vite": "^8.0.10"
  },
  "dependencies": {},
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sambelteshazzar/Uni-Hub.git"
  },
  "bugs": {
    "url": "https://github.com/sambelteshazzar/Uni-Hub/issues"
  },
  "homepage": "https://github.com/sambelteshazzar/Uni-Hub#readme",
  "allowScripts": {
    "esbuild@0.27.0": true
  }
}
