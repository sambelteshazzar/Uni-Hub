{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "indent": ["error", 2],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["warn", "error", "info"] }],
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"],
    "no-var": "error",
    "prefer-const": "error",
    "no-multiple-empty-lines": ["error", { "max": 1 }],
    "comma-dangle": ["error", "always-multiline"],
    "object-curly-spacing": ["error", "always"],
    "array-bracket-spacing": ["error", "never"],
    "space-before-function-paren": ["error", "always"],
    "keyword-spacing": ["error", { "before": true, "after": true }],
    "key-spacing": ["error", { "beforeColon": false, "afterColon": true }],
    "no-trailing-spaces": "error",
    "eol-last": "error",
    "no-useless-catch": "off"
  },
  "globals": {
    "APP_NAME": "readonly",
    "API_URL": "readonly",
    "io": "readonly",
    "APP_VERSION": "readonly",
    "STORAGE_KEY_PREFIX": "readonly",
    "STORAGE_KEYS": "readonly",
    "API_ENDPOINTS": "readonly",
    "PRODUCT_CONDITIONS": "readonly",
    "CATEGORIES": "readonly",
    "DELIVERY_MODES": "readonly",
    "PAYMENT_MODES": "readonly",
    "USER_ROLES": "readonly",
    "ORDER_STATUS": "readonly",
    "ROUTES": "readonly",
    "SORT_OPTIONS": "readonly",
    "VALIDATION_PATTERNS": "readonly",
    "ERROR_MESSAGES": "readonly",
    "SUCCESS_MESSAGES": "readonly",
    "PAGINATION": "readonly",
    "TIME": "readonly",
    "StorageManager": "readonly",
    "Validator": "readonly",
    "Formatter": "readonly",
    "CryptoUtil": "readonly",
    "api": "readonly",
    "_api": "readonly",
    "router": "readonly",
    "app": "readonly",
    "Pages": "readonly",
    "authManager": "readonly",
    "_authManager": "readonly",
    "productsManager": "readonly",
    "cartManager": "readonly",
    "_cartManager": "readonly",
    "checkoutManager": "readonly",
    "_checkoutManager": "readonly",
    "paymentManager": "readonly",
    "_paymentManager": "readonly",
    "deliveryManager": "readonly",
    "_deliveryManager": "readonly",
    "regionManager": "readonly",
    "_regionManager": "readonly",
    "searchManager": "readonly",
    "_searchManager": "readonly",
    "toastManager": "readonly",
    "_toastManager": "readonly",
    "notificationManager": "readonly",
    "_notificationManager": "readonly",
    "modalManager": "readonly",
    "_modalManager": "readonly",
    "messageManager": "readonly",
    "_messageManager": "readonly",
    "reviewManager": "readonly",
    "_reviewManager": "readonly",
    "messagesPage": "readonly",
    "_messagesPage": "readonly",
    "adminAuthManager": "readonly",
    "_adminAuthManager": "readonly",
    "adminProductsManager": "readonly",
    "_adminProductsManager": "readonly",
    "adminUsersManager": "readonly",
    "_adminUsersManager": "readonly",
    "adminOrdersManager": "readonly",
    "_adminOrdersManager": "readonly",
    "adminReportsManager": "readonly",
    "_adminReportsManager": "readonly",
    "hostelProductsManager": "readonly",
    "_hostelProductsManager": "readonly",
    "BasePage": "readonly",
    "AuthPage": "readonly",
    "LandingPage": "readonly",
    "Pages": "readonly"
  },
  "ignorePatterns": ["node_modules/", "dist/", "backend/node_modules/"]
}
